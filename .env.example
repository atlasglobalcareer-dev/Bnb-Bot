# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional but recommended: https://bscscan.com/apis ---
BSCSCAN_API_KEY=

# --- BNB token target ---
# Product hard ceiling: alerts are ONLY for market cap below $50,000.
MIN_MARKET_CAP_USD=0
MAX_MARKET_CAP_USD=50000

# Liquidity is audited/scored and shown in alerts; it does not hide tokens.
MIN_LIQUIDITY_USD=0

# 0 = alert every non-honeypot token below $50K and show its full score/audit.
MIN_SCORE_TO_ALERT=0

# Pool age affects the score but does not prevent the audit from running.
MIN_POOL_AGE_MINUTES=0
MAX_POOL_AGE_MINUTES=4320

# --- Scanning ---
POLL_INTERVAL_SECONDS=120

# --- Storage ---
DATABASE_PATH=data/scanner.db
