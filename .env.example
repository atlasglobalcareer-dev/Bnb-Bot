# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional but recommended: https://bscscan.com/apis (free tier) ---
BSCSCAN_API_KEY=

# --- Screener filters ---
MIN_MARKET_CAP_USD=50000
MAX_MARKET_CAP_USD=3000000
MIN_LIQUIDITY_USD=10000
MIN_SCORE_TO_ALERT=65

# Minimum/maximum pool age in minutes considered "in the sweet spot"
# (too new = high rug risk, too old = momentum likely already priced in)
MIN_POOL_AGE_MINUTES=30
MAX_POOL_AGE_MINUTES=4320

# --- Scanning ---
POLL_INTERVAL_SECONDS=120

# --- Storage ---
DATABASE_PATH=data/scanner.db
